EMBEDDING_DIMENSION=
RERANKER_PROVIDER=local
RERANKER_MODEL=
RERANKER_REVISION=
RERANK_MIN_SCORE=
MAX_CONTEXT_TOKENS=
MAX_OUTPUT_TOKENS=
QUERY_COST_LIMIT=
TOPIC_COMPARE_COST_LIMIT=
ADMIN_API_TOKEN=
READER_API_TOKEN=
AUTH_MODE=local
ENABLE_DEBUG=false
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
DENSE_TOP_K=30
SPARSE_TOP_K=30
RETRIEVAL_TOP_K=30
RERANK_TOP_K=7
MAX_QUERY_VARIANTS=3
MAX_UPLOAD_BYTES=52428800
